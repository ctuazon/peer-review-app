# Copy to .env (gitignored) next to main.py and fill in.
# Values entered in File > Settings take precedence; blank Settings fields
# fall back to these. System environment variables also work.

# Jira ticket context: tickets referenced in the PR title, body or branch
# (e.g. ABC-123) are fetched and added to review/explain prompts.
# Create an API token at https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_ENABLED=true
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
